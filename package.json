{
  "name": "edtech-cloud-deploy",
  "version": "1.0.0",
  "description": "Containerized Node.js task workers on AWS ECS/Fargate that auto-scale on RabbitMQ queue depth — Clean Architecture app, Terraform IaC, CI/CD and Prometheus/Grafana monitoring.",
  "main": "dist/index.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:rollback": "tsx src/migrate.ts --rollback",
    "seed": "tsx scripts/seed.ts",
    "load-test": "tsx scripts/load-test.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/ scripts/ --max-warnings 0",
    "format": "prettier --write \"{src,tests,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:localstack": "docker-compose -f docker-compose.yml -f docker-compose.localstack.yml up -d",
    "bench:scaling": "tsx scripts/scaling-verification.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1146.0",
    "amqplib": "^2.2.0",
    "aws-ssl-profiles": "^1.1.2",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "mysql2": "^3.24.5",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testcontainers/mysql": "^12.2.0",
    "@testcontainers/rabbitmq": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "commander": "^14.0.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "rimraf": "^5.0.10",
    "supertest": "^7.1.0",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
