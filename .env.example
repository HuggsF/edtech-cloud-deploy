# Environment & Process Role
NODE_ENV=development
APP_ROLE=api
PORT=3000
METRICS_PORT=9464
LOG_LEVEL=info
LOG_PRETTY=true

# Database (MySQL / AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=edtech
DB_PASSWORD=edtech_secret
DB_NAME=edtech
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_MIGRATE_ON_START=true
DB_SSL=false

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=edtech.tasks
RABBITMQ_DLQ=edtech.tasks.dlq
RABBITMQ_PREFETCH=10
RABBITMQ_DELIVERY_LIMIT=20
RABBITMQ_HEARTBEAT_SECONDS=30
RABBITMQ_CONNECT_RETRIES=10
RABBITMQ_CONNECT_RETRY_DELAY_MS=2000
RABBITMQ_PUBLISH_TIMEOUT_MS=5000

# Task Simulation & Execution
TASK_MAX_ATTEMPTS=3
TASK_DURATION_MS=250
TASK_DURATION_JITTER=0.5
TASK_FAILURE_RATE=0.02
TASK_REQUEUE_DELAY_MS=2000

# Observability & CloudWatch (AWS / LocalStack)
QUEUE_METRICS_INTERVAL_MS=15000
CLOUDWATCH_METRICS_ENABLED=false
CLOUDWATCH_NAMESPACE=Custom/EdTech
AWS_REGION=us-east-1
CLOUDWATCH_ENDPOINT=

# Graceful Shutdown
SHUTDOWN_TIMEOUT_MS=45000
SHUTDOWN_DRAIN_TIMEOUT_MS=30000
